generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// Representa a un empleado o persona con acceso al sistema
model Usuario {
  /// Identificador único del usuario (UUID)
  id                         String       @id @default(uuid())
  /// Número de documento (RUT sin dígito verificador, o número de pasaporte)
  rut                        String?      @unique
  /// Dígito verificador del RUT
  dv                         String?
  /// Correo electrónico (usado para iniciar sesión)
  correo                     String?      @unique
  /// Contraseña encriptada
  claveHash                  String?
  /// Primer y/o segundo nombre
  nombre                     String?
  /// Apellido Paterno
  apellidoPaterno            String?
  /// Apellido Materno
  apellidoMaterno            String?
  /// PIN de 4 dígitos para acceso rápido en la caja (POS)
  codigoPin                  String?      @unique
  /// Fecha de creación del registro
  creadoEn                   DateTime?
  /// Fecha de última modificación
  actualizadoEn              DateTime?    @updatedAt
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids                        Int          @unique(map: "ids") @default(autoincrement())
  /// Tipo de documento (RUT, PASAPORTE, DNI, etc.)
  tipoDocumento              String       @default("RUT")
  /// Indica si el usuario puede acceder al sistema
  estado                     String?      @default("A") @db.Char(1)
  imagenUrl                  String?      @db.LongText
  direccion                  String?
  telefono                   String?
  comunaId                   Int?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  regionId                   Int?
  ciudadId                   Int?
  pedidos                    Pedido[]     @relation("PedidosMesero")
  ciudad                     Ciudad?      @relation(fields: [ciudadId], references: [id_ciudad])
  comuna                     Comuna?      @relation(fields: [comunaId], references: [id_comuna])
  region                     Region?      @relation(fields: [regionId], references: [id_region])
  rolesUsuario               UsuarioRol[]

  @@index([comunaId], map: "usuarios_comunaId_fkey")
  @@index([ciudadId], map: "usuarios_ciudadId_fkey")
  @@index([regionId], map: "usuarios_regionId_fkey")
  @@map("usuarios")
}

model Region {
  id_region     Int       @id @default(autoincrement())
  descripcion   String?   @db.VarChar(100)
  estado_region String?   @db.VarChar(50)
  ciudades      Ciudad[]
  usuarios      Usuario[]

  @@map("region")
}

model Ciudad {
  id_ciudad     Int       @id @default(autoincrement())
  descripcion   String?   @db.VarChar(100)
  estado_ciudad String?   @db.VarChar(50)
  id_region     Int?
  region        Region?   @relation(fields: [id_region], references: [id_region])
  comunas       Comuna[]
  usuarios      Usuario[]

  @@index([id_region], map: "ciudad_id_region_fkey")
  @@map("ciudad")
}

model Comuna {
  id_comuna     Int       @id @default(autoincrement())
  descripcion   String?   @db.VarChar(100)
  estado_comuna String?   @db.VarChar(100)
  id_ciudad     Int?
  ciudad        Ciudad?   @relation(fields: [id_ciudad], references: [id_ciudad])
  usuarios      Usuario[]

  @@index([id_ciudad], map: "comuna_id_ciudad_fkey")
  @@map("comuna")
}

/// Representa un rol o cargo dentro del sistema
model Rol {
  /// Identificador único del rol
  id           String       @id @default(uuid())
  /// Nombre del rol (ej. ADMINISTRADOR)
  nombre       String?      @unique
  /// Breve descripción de los permisos del rol
  descripcion  String?
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids          Int          @unique(map: "ids") @default(autoincrement())
  rolesUsuario UsuarioRol[]

  @@map("roles")
}

/// Tabla intermedia para asignar múltiples roles a un usuario
model UsuarioRol {
  /// ID del usuario
  usuarioId String
  /// ID del rol asignado
  rolId     String
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@index([rolId], map: "usuarios_roles_rolId_fkey")
  @@map("usuarios_roles")
}

/// Categoría principal para organizar los productos (ej. Bebidas, Platos de Fondo)
model Categoria {
  /// Identificador único de la categoría
  id     String  @id @default(uuid())
  /// Nombre visible de la categoría
  nombre String
  /// Nombre del ícono para mostrar en el frontend
  icono  String?
  /// Número para ordenar la categoría en el menú
  orden  Int     @default(0)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids    Int     @unique(map: "ids") @default(autoincrement())
  /// Estado (A = Activo, I = Inactivo)
  estado String  @default("A") @db.Char(1)

  @@map("categorias")
}

/// Producto vendible en el restaurante
model Producto {
  /// Identificador único del producto
  id              String          @id @default(uuid())
  /// ID de la categoría a la que pertenece
  categoriaId     String
  /// Nombre del producto
  nombre          String
  /// Descripción o ingredientes visibles para el cliente
  descripcion     String?         @db.Text
  /// Precio base de venta
  precio          Decimal         @db.Decimal(10, 2)
  /// Código de barra o identificador único de inventario
  sku             String?         @unique
  /// URL de la foto del producto
  imagen          String?
  /// Área donde se prepara este producto (ej. COCINA, BAR)
  areaPreparacion AreaPreparacion @default(COCINA)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids             Int             @unique(map: "ids") @default(autoincrement())
  /// Orden del producto para mostrarse
  orden           Int             @default(0)
  /// Estado (A = Activo, I = Inactivo)
  estado          String          @default("A") @db.Char(1)

  @@map("productos")
}

/// Tamaños o variaciones de un producto base (ej. Pizza Familiar vs Personal)
model VarianteProducto {
  /// Identificador único de la variante
  id          String       @id @default(uuid())
  /// Producto padre
  productoId  String?
  /// Nombre de la variante (ej. "Familiar")
  nombre      String?
  /// Precio de esta variante específica
  precio      Decimal?     @db.Decimal(10, 2)
  /// Código SKU específico
  sku         String?
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids         Int          @unique(map: "ids") @default(autoincrement())
  itemsPedido ItemPedido[]

  @@map("variantes_producto")
}

/// Grupo de modificadores u opciones (ej. "Elige tu salsa", "Término de la carne")
model GrupoModificador {
  /// ID único del grupo
  id           String  @id @default(uuid())
  /// Producto al que pertenece este grupo
  productoId   String
  /// Nombre de la instrucción (ej. "Elige 2 salsas")
  nombre       String
  /// Cantidad mínima que el cliente debe elegir (0 = opcional)
  minSeleccion Int     @default(0)
  /// Cantidad máxima que el cliente puede elegir
  maxSeleccion Int     @default(1)
  /// Atajo para saber si debe seleccionarse obligatoriamente
  esRequerido  Boolean @default(false)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids          Int     @unique(map: "ids") @default(autoincrement())

  @@map("grupos_modificadores")
}

/// Modificador individual (ej. "Ketchup", "Bien cocido", "Sin cebolla")
model Modificador {
  /// ID único
  id                      String                  @id @default(uuid())
  /// Grupo al que pertenece
  grupoModificadorId      String
  /// Nombre de la opción
  nombre                  String
  /// Costo extra si el cliente elige esta opción
  precioAdicional         Decimal                 @default(0.00) @db.Decimal(10, 2)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids                     Int                     @unique(map: "ids") @default(autoincrement())
  modificadoresItemPedido ModificadorItemPedido[]

  @@map("modificadores")
}

/// Ingredientes o insumos base que no se venden directamente pero componen las recetas
model Insumo {
  /// ID del insumo
  id             String       @id @default(uuid())
  /// Nombre del insumo (ej. "Tomate", "Carne Molida")
  nombre         String
  /// Unidad en la que se mide su stock
  unidad         UnidadMedida
  /// Stock disponible actualmente
  stockActual    Decimal      @default(0.000) @db.Decimal(10, 3)
  /// Alerta de stock bajo
  stockMinimo    Decimal      @default(0.000) @db.Decimal(10, 3)
  /// Costo promedio por unidad
  costoPorUnidad Decimal      @default(0.00) @db.Decimal(10, 2)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids            Int          @unique(map: "ids") @default(autoincrement())

  @@map("insumos")
}

/// Relación de ingredientes que componen un Producto
model RecetaProducto {
  /// ID único
  id         String  @id @default(uuid())
  /// Producto final
  productoId String
  /// Insumo requerido
  insumoId   String
  /// Cuánto insumo se descuenta por cada producto vendido
  cantidad   Decimal @db.Decimal(10, 3)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids        Int     @unique(map: "ids") @default(autoincrement())

  @@map("recetas_producto")
}

/// Historial de movimientos (Kardex) de cada insumo
model MovimientoInventario {
  /// ID único del movimiento
  id        String         @id @default(uuid())
  /// Insumo modificado
  insumoId  String
  /// Empleado que registró o provocó el movimiento
  usuarioId String
  /// Clasificación del movimiento
  tipo      TipoMovimiento
  /// Cantidad sumada o restada
  cantidad  Decimal        @db.Decimal(10, 3)
  /// Costo total de este movimiento (si aplica)
  costo     Decimal?       @db.Decimal(10, 2)
  /// Motivo o razón (ej. "Tomates en mal estado")
  notas     String?
  /// Fecha y hora exacta
  creadoEn  DateTime       @default(now())
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids       Int            @unique(map: "ids") @default(autoincrement())

  @@map("movimientos_inventario")
}

/// Zonas del local (ej. Terraza, Primer Piso)
model AreaSalon {
  /// ID del área
  id     String @id @default(uuid())
  /// Nombre del área
  nombre String
  /// Orden para mostrar en pestañas
  orden  Int    @default(0)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids    Int    @unique(map: "ids") @default(autoincrement())

  @@map("areas_salon")
}

/// Mesa individual dentro de un área
model Mesa {
  /// ID único de la mesa
  id          String      @id @default(uuid())
  /// ID del área a la que pertenece
  areaSalonId String
  /// Identificador visible (ej. "Mesa 5", "T-12")
  numeroMesa  String
  /// Cuántas personas caben
  capacidad   Int         @default(4)
  /// Si está libre, ocupada, etc.
  estado      EstadoMesa? @default(D)
  /// Eje X en el mapa visual
  posX        Int         @default(0)
  /// Eje Y en el mapa visual
  posY        Int         @default(0)
  /// Forma visual de la mesa (redonda, cuadrada, rectangular, barra)
  shape       String?     @default("redonda")
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids         Int         @unique(map: "ids") @default(autoincrement())
  pedidos     Pedido[]

  @@map("mesas")
}

/// Cabecera de la cuenta o comanda
model Pedido {
  /// ID único del pedido (UUID)
  id               String                  @id @default(uuid())
  /// Número autoincremental fácil de leer para el cliente
  numeroPedido     Int                     @unique @default(autoincrement())
  /// Modalidad de venta
  tipoPedido       TipoPedido              @default(SALON)
  /// Estado general del ticket
  estado           EstadoPedido            @default(INGRESADO)
  /// Si es SALON, qué mesa es
  mesaId           String?
  /// Quién atendió la mesa
  meseroId         String?
  /// Para delivery o para llevar
  nombreCliente    String?
  telefonoCliente  String?
  notas            String?
  /// Suma de precios sin impuesto
  subtotal         Decimal                 @db.Decimal(10, 2)
  /// Monto de impuestos calculados
  impuestos        Decimal                 @db.Decimal(10, 2)
  /// Descuentos aplicados
  descuento        Decimal                 @default(0.00) @db.Decimal(10, 2)
  /// Propina voluntaria dejada
  propina          Decimal                 @default(0.00) @db.Decimal(10, 2)
  /// Gran total a pagar
  total            Decimal                 @db.Decimal(10, 2)
  creadoEn         DateTime                @default(now())
  actualizadoEn    DateTime                @updatedAt
  historialEstados HistorialEstadoPedido[]
  mesa             Mesa?                   @relation(fields: [mesaId], references: [id])
  mesero           Usuario?                @relation("PedidosMesero", fields: [meseroId], references: [id])

  @@index([mesaId], map: "pedidos_mesaId_fkey")
  @@index([meseroId], map: "pedidos_meseroId_fkey")
  @@map("pedidos")
}

/// Catálogo y parametrización de estados de pedido por canal (Salón, Llevar, Delivery)
model EstadoPedidoConfig {
  /// Identificador único UUID
  id                  String                  @id @default(uuid())
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids                 Int                     @unique(map: "ids") @default(autoincrement())
  /// Código técnico identificador (ej: INGRESADO, EN_COCINA, LISTO, SERVIDO, EN_CAMINO, ENTREGADO, CANCELADO)
  codigo              String
  /// Canal aplicable: SALON, PARA_LLEVAR, DELIVERY o TODOS
  canal               String                  @default("SALON")
  /// Orden secuencial en el flujo del canal (ej: 1, 2, 3...)
  paso                Int                     @default(1)
  /// Nombre amigable según el canal (ej: "Listo para Mesa", "Listo para Retiro", "Listo para Envío")
  nombre              String
  /// Explicación operativa del estado
  descripcion         String?                 @db.Text
  /// Color hexadecimal para badges e indicadores visuales en UI
  colorHex            String                  @default("#D96B27")
  /// Bandera para estados de alerta/anulación (ej: Cancelado)
  esAlerta            Boolean                 @default(false)
  /// Umbral máximo en minutos antes de activar alerta visual de Retrasado (ej: 20 min en cocina)
  tiempoMaximoMinutos Int?
  /// Estado del registro (A = Activo, I = Inactivo)
  estado              String                  @default("A") @db.Char(1)
  historial           HistorialEstadoPedido[]

  @@unique([codigo, canal])
  @@map("estados_pedido")
}

/// Registro histórico y auditoría del paso de pedidos por cada estado
model HistorialEstadoPedido {
  /// Identificador único UUID
  id              String             @id @default(uuid())
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids             Int                @unique(map: "ids") @default(autoincrement())
  /// Pedido al que pertenece el cambio de estado
  pedidoId        String
  /// Estado aplicado
  estadoId        String
  /// Usuario / empleado que realizó el cambio de estado
  usuarioId       String?
  /// Momento exacto de la transición
  cambiadoEn      DateTime           @default(now())
  /// Minutos transcurridos en el estado anterior
  minutosEnEstado Int?
  /// Notas o motivos (ej: justificación de anulación)
  notas           String?            @db.Text
  estadoConfig    EstadoPedidoConfig @relation(fields: [estadoId], references: [id])
  pedido          Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId], map: "historial_estados_pedido_pedidoId_fkey")
  @@index([estadoId], map: "historial_estados_pedido_estadoId_fkey")
  @@map("historial_estados_pedido")
}

/// Plato o bebida específica dentro de un Pedido
model ItemPedido {
  /// ID del ítem
  id               String                  @id @default(uuid())
  /// Pedido al que pertenece
  pedidoId         String
  /// Qué producto es
  productoId       String
  /// Si eligió tamaño familiar, etc.
  varianteId       String?
  /// Cantidad pedida
  cantidad         Int                     @default(1)
  /// Precio de 1 unidad
  precioUnitario   Decimal                 @db.Decimal(10, 2)
  /// Precio final (cantidad * precioUnitario + extras)
  precioTotal      Decimal                 @db.Decimal(10, 2)
  /// Estado en la estación de preparación
  estado           EstadoItemPedido        @default(PENDIENTE)
  /// Indicaciones (ej. "Poco ají")
  notas            String?
  /// A qué impresora/pantalla KDS se envió
  areaPreparacion  AreaPreparacion         @default(COCINA)
  /// Hora exacta en la que se comandó
  enviadoACocinaEn DateTime?
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids              Int                     @unique(map: "ids") @default(autoincrement())
  variante         VarianteProducto?       @relation(fields: [varianteId], references: [id])
  modificadores    ModificadorItemPedido[]

  @@index([varianteId], map: "items_pedido_varianteId_fkey")
  @@map("items_pedido")
}

/// Modificador específico elegido para un ItemPedido
model ModificadorItemPedido {
  id            String      @id @default(uuid())
  itemPedidoId  String
  modificadorId String
  /// Precio cobrado por este extra
  precio        Decimal     @db.Decimal(10, 2)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids           Int         @unique(map: "ids") @default(autoincrement())
  itemPedido    ItemPedido  @relation(fields: [itemPedidoId], references: [id], onDelete: Cascade)
  modificador   Modificador @relation(fields: [modificadorId], references: [id])

  @@index([itemPedidoId], map: "modificadores_item_pedido_itemPedidoId_fkey")
  @@index([modificadorId], map: "modificadores_item_pedido_modificadorId_fkey")
  @@map("modificadores_item_pedido")
}

/// Formas de pago aceptadas (Dinámico para poder activar/desactivar)
model MetodoPago {
  /// ID único del método
  id     String @id @default(uuid())
  /// Nombre visible (ej. "Efectivo", "Transbank", "MercadoPago")
  nombre String @unique
  /// Código interno 
  codigo String @unique
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids    Int    @unique(map: "ids") @default(autoincrement())
  /// Estado (A = Activo, I = Inactivo)
  estado String @default("A") @db.Char(1)

  @@map("metodos_pago")
}

/// Abono o pago realizado a un pedido
model Pago {
  /// ID del registro de pago
  id               String   @id @default(uuid())
  /// A qué pedido pertenece
  pedidoId         String
  /// En qué turno de caja se recibió
  turnoId          String
  /// Cuánto se pagó
  monto            Decimal  @db.Decimal(10, 2)
  /// ID del Método de pago usado
  metodoPagoId     String
  /// Nro de voucher o transferencia
  numeroReferencia String?
  /// Hora del pago
  creadoEn         DateTime @default(now())
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids              Int      @unique(map: "ids") @default(autoincrement())

  @@map("pagos")
}

/// Control de apertura y cierre de caja
model TurnoCaja {
  /// ID del turno
  id               String    @id @default(uuid())
  /// Cajero responsable
  usuarioId        String?
  /// Hora en que abrió
  abiertoEn        DateTime?
  /// Hora del cierre
  cerradoEn        DateTime?
  /// Con cuánto sencillo empezó
  efectivoInicial  Decimal?  @db.Decimal(10, 2)
  /// Cuánto debería haber según el sistema
  efectivoEsperado Decimal?  @db.Decimal(10, 2)
  /// Cuánto contó el cajero físicamente
  efectivoReal     Decimal?  @db.Decimal(10, 2)
  /// Sobrante o Faltante
  diferencia       Decimal?  @db.Decimal(10, 2)
  /// Estado actual de este turno
  estado           String?
  /// Justificaciones de descuadres
  notas            String?
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids              Int       @unique(map: "ids") @default(autoincrement())

  @@map("turnos_caja")
}

/// Configuración de puntos de impresión
model ConfiguracionImpresora {
  /// ID de impresora
  id             String           @id @default(uuid())
  /// Ej: "Impresora Barra", "Impresora Cocina"
  nombre         String
  /// Qué platos manda a imprimir acá
  areaDestino    AreaPreparacion?
  /// RED_IP o USB
  tipoConexion   TipoConexion     @default(RED_IP)
  /// IP (si es de red)
  direccionIp    String?
  /// Puerto
  puerto         Int              @default(9100)
  /// 80mm o 58mm
  anchoPapelMm   Int              @default(80)
  /// Si es la que emite boletas principales
  esPosPrincipal Boolean          @default(false)
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids            Int              @unique(map: "ids") @default(autoincrement())
  /// Estado (A = Activo, I = Inactivo)
  estado         String           @default("A") @db.Char(1)

  @@map("configuraciones_impresora")
}

/// Datos principales de la empresa (aparecen en ticket)
model ConfiguracionEmpresa {
  id                 String  @id @default(uuid())
  /// Nombre o Razón Social
  nombreEmpresa      String
  /// RUT / NIT / RUC
  ruc                String
  /// Dirección matriz
  direccion          String
  /// Número de contacto
  telefono           String
  /// Símbolo de peso/dólar
  simboloMoneda      String  @default("$")
  /// IVA / IGV
  porcentajeImpuesto Decimal @default(18.00) @db.Decimal(5, 2)
  /// Mensaje superior del ticket
  cabeceraImpresion  String? @db.Text
  /// Mensaje de agradecimiento
  pieImpresion       String? @db.Text
  /// Identificador secundario legible para humanos y uso en frontend/caja
  ids                Int     @unique(map: "ids") @default(autoincrement())

  @@map("configuracion_empresa")
}

/// Zonas de impresión y preparación del restaurante
enum AreaPreparacion {
  COCINA
  BAR
  POSTRES
  PARRILLA
}

/// Unidades de medida para el control de inventario
enum UnidadMedida {
  KG
  GRAMOS
  LITROS
  MILILITROS
  CC
  CM
  METROS
  UNIDADES
  CANTIDAD
  PORCION
}

/// Tipos de ajuste en el Kardex/Inventario
enum TipoMovimiento {
  ENTRADA
  SALIDA
  VENTA
  MERMA
  AJUSTE
}

/// Situación actual de una mesa en el salón
enum EstadoMesa {
  D
  CS
  R
  O
  L
  EM
}

/// Origen del pedido
enum TipoPedido {
  SALON
  PARA_LLEVAR
  DELIVERY
}

/// Estado individual de cada plato en la cocina
enum EstadoItemPedido {
  PENDIENTE
  PREPARANDO
  LISTO
  SERVIDO
  CANCELADO
}

/// Cómo se comunica el POS con la impresora
enum TipoConexion {
  RED_IP
  USB_AGENTE_LOCAL
}

enum EstadoPedido {
  INGRESADO
  EN_COCINA
  LISTO_MESA
  LISTO_RETIRO
  LISTO_ENVIO
  SERVIDO
  EN_CAMINO
  ENTREGADO
  PAGADO_CERRADO
  CANCELADO
  RETRASADO
  PENDIENTE
  LISTO
  PAGADO
}
